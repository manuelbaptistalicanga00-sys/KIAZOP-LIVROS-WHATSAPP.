# Vercel + WhatsApp Cloud API oficial (adicionar em Vercel > Settings > Environment Variables).
# Estes valores são exemplos; substituir pelos teus valores reais apenas no painel Vercel.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_META_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v22.0

# Recomendado: deduplicação persistente de webhooks com Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LEGADO: só necessário se optares por continuar a usar n8n + Evolution API num servidor.
# Não é usado pela nova integração Vercel + WhatsApp Cloud API.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.com/
WEBHOOK_URL=https://n8n.example.com/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Africa/Luanda
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_INSTANCE=CHANGE_ME_INSTANCE_NAME
EVOLUTION_API_KEY=CHANGE_ME_SECRET

# Nunca commitar credenciais reais, nem enviar tokens/segredos em capturas de ecrã.
